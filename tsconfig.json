{
  "compilerOptions": {
    // Node.js の ESM と同じ規則で import を解決する。相対 import には出力後の .js を書く。
    "module": "NodeNext",
    "target": "ES2024",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    // 型エラーを解消するまで生成物を更新しない。
    "strict": true,
    "noEmitOnError": true
  },
  "include": ["src/**/*"]
}
